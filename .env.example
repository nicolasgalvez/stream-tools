# YouTube OAuth credentials (optional - for non-interactive/headless auth)
# Run `./scripts/export-yt-credentials` to populate these from your local login
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# AzuraCast API configuration (optional - for station control)
AZURACAST_URL=https://your-azuracast-server.com/
AZURACAST_API_KEY=your-api-key
AZURACAST_STATION_ID=1

# Stream ID that `yt stream watch` monitors when no STREAM_ID argument is given.
# Required by the Docker service, which refuses to start without it.
# Find it with `yt stream list`.
YT_WATCH_STREAM_ID=

# Discord webhook for stream monitoring notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
